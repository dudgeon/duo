{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "../../out/web/daemon",
    "rootDir": "../..",
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "src/**/*",
    "../shared/**/*",
    "../../shared/**/*"
  ],
  "exclude": ["node_modules"]
}
