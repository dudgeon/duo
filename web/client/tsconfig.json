{
  "extends": "../../tsconfig.web.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "paths": {
      "@shared/*": ["../../shared/*"],
      "@renderer/*": ["../../renderer/*"]
    }
  },
  "include": [
    "src/**/*",
    "../shared/**/*",
    "../../renderer/**/*",
    "../../shared/**/*"
  ],
  "exclude": ["node_modules"]
}
