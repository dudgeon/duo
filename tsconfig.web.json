{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "composite": true,
    "types": ["vite/client"],
    "paths": {
      "@shared/*": ["./shared/*"]
    }
  },
  "include": [
    "renderer/**/*",
    "shared/**/*",
    "core/html/**/*",
    "core/markdown/**/*",
    "core/json/**/*",
    // ENH-221 — the Open-bar resolver is PURE (only a type-only import from
    // shared/types), so the renderer Open bar can share it with the CLI/main.
    "core/open-resolve.ts"
  ],
  // vaultGotoMatchBridge.test.ts deliberately crosses layers (core/vault
  // search -> editor jump) to pin the docMatchIndex bridge; core/vault is
  // node-only (node:fs), so the composite web project can't list it.
  // vitest still runs the test -- it's only excluded from tsc.
  "exclude": ["node_modules", "renderer/components/editor/vaultGotoMatchBridge.test.ts"]
}
